#!/usr/bin/env bash
set -euo pipefail

window="${1:-}"

if [[ -z "$window" ]]; then
  tmux display-message "Missing tmux window target"
  exit 64
fi

session="$(tmux display-message -p -t "$window" '#{session_id}')"

near() {
  local a=$1 b=$2
  local d=$(( a > b ? a - b : b - a ))
  (( d <= 1 ))
}

# Horizontally aligned panes share one top edge and one height.
horizontally_aligned() {
  local target="$1"
  local top height
  local base_top base_height
  local first=1
  local row
  mapfile -t rows < <(tmux list-panes -t "$target" -F '#{pane_top} #{pane_height}')
  if (( ${#rows[@]} < 2 )); then
    return 0
  fi
  for row in "${rows[@]}"; do
    read -r top height <<<"$row"
    if (( first )); then
      base_top=$top
      base_height=$height
      first=0
      continue
    fi
    near "$top" "$base_top" || return 1
    near "$height" "$base_height" || return 1
  done
  return 0
}

equalize_window() {
  local target="$1"
  local current
  local pane
  current="$(tmux display-message -p -t "$target" '#{window_panes}')"
  case "$current" in
    ''|*[!0-9]*)
      return 0
      ;;
  esac
  if (( current < 2 )); then
    return 0
  fi

  if horizontally_aligned "$target"; then
    # select-layout -E evens only the current pane's sibling group. Visit every
    # pane twice so an outer split is evened after an inner one, and the reverse.
    mapfile -t panes < <(tmux list-panes -t "$target" -F '#{pane_id}')
    for _ in 1 2; do
      for pane in "${panes[@]}"; do
        [[ -n "$pane" ]] || continue
        tmux select-layout -t "$pane" -E >/dev/null
      done
    done
    return
  fi

  tmux select-layout -t "$target" even-horizontal >/dev/null
}

# A shell with no child is an unused pane. A command, or a shell running one,
# is in use. A dead pane is unused even when it is the last pane.
shell_without_children() {
  local pid=$1
  local comm
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  comm="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
  comm="${comm//[[:space:]]/}"
  case "$comm" in
    bash|zsh|fish|sh|dash|nu) ;;
    *) return 1 ;;
  esac
  if pgrep -P "$pid" >/dev/null 2>&1; then
    return 1
  fi
  return 0
}

close_unused_panes() {
  local target=$1
  local listing pane dead pid active_flag spare
  local -a idle=() dead_panes=() busy=()
  listing="$(tmux list-panes -t "$target" -F '#{pane_id} #{pane_dead} #{pane_pid} #{pane_active}' 2>/dev/null || true)"
  [[ -n "$listing" ]] || return 0
  while read -r pane dead pid active_flag; do
    [[ -n "$pane" ]] || continue
    if [[ "$dead" == 1 ]]; then
      dead_panes+=("$pane")
      continue
    fi
    if shell_without_children "$pid"; then
      idle+=("$pane")
      if [[ "$active_flag" == 1 ]]; then
        spare=$pane
      fi
    else
      busy+=("$pane")
    fi
  done <<<"$listing"
  if (( ${#busy[@]} == 0 && ${#idle[@]} > 0 )); then
    [[ -n "${spare:-}" ]] || spare="${idle[0]}"
  else
    spare=
  fi
  for pane in "${dead_panes[@]}"; do
    tmux kill-pane -t "$pane" || true
  done
  for pane in "${idle[@]}"; do
    [[ "$pane" == "${spare:-}" ]] && continue
    tmux kill-pane -t "$pane" || true
  done
}

window_open() {
  tmux display-message -p -t "$1" '#{window_id}' >/dev/null 2>&1
}

mapfile -t windows < <(tmux list-windows -t "$session" -F '#{window_id}')
for window in "${windows[@]}"; do
  [[ -n "$window" ]] || continue
  close_unused_panes "$window"
done
for window in "${windows[@]}"; do
  [[ -n "$window" ]] || continue
  window_open "$window" || continue
  equalize_window "$window"
done
