#!/usr/bin/env bash
set -euo pipefail

window="${1:-}"

if [[ -z "$window" ]]; then
  tmux display-message "Missing tmux window target"
  exit 64
fi

session="$(tmux display-message -p -t "$window" '#{session_id}')"

near() {
  local a=$1 b=$2
  local d=$(( a > b ? a - b : b - a ))
  (( d <= 1 ))
}

# Horizontally aligned panes share one top edge and one height.
horizontally_aligned() {
  local target="$1"
  local top height
  local base_top base_height
  local first=1
  local row
  mapfile -t rows < <(tmux list-panes -t "$target" -F '#{pane_top} #{pane_height}')
  if (( ${#rows[@]} < 2 )); then
    return 0
  fi
  for row in "${rows[@]}"; do
    read -r top height <<<"$row"
    if (( first )); then
      base_top=$top
      base_height=$height
      first=0
      continue
    fi
    near "$top" "$base_top" || return 1
    near "$height" "$base_height" || return 1
  done
  return 0
}

equalize_window() {
  local target="$1"
  local current
  local pane
  current="$(tmux display-message -p -t "$target" '#{window_panes}')"
  case "$current" in
    ''|*[!0-9]*)
      return 0
      ;;
  esac
  if (( current < 2 )); then
    return 0
  fi

  if horizontally_aligned "$target"; then
    # select-layout -E evens only the current pane's sibling group. Visit every
    # pane twice so an outer split is evened after an inner one, and the reverse.
    mapfile -t panes < <(tmux list-panes -t "$target" -F '#{pane_id}')
    for _ in 1 2; do
      for pane in "${panes[@]}"; do
        [[ -n "$pane" ]] || continue
        tmux select-layout -t "$pane" -E >/dev/null
      done
    done
    return
  fi

  tmux select-layout -t "$target" even-horizontal >/dev/null
}

mapfile -t windows < <(tmux list-windows -t "$session" -F '#{window_id}')
for window in "${windows[@]}"; do
  [[ -n "$window" ]] || continue
  equalize_window "$window"
done
